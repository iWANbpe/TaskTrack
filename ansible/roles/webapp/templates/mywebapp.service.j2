[Unit]
Description=Gunicorn instance for TaskTrack
After=network.target

[Service]
User={{ webapp_user }}
Group={{ webapp_group }}
WorkingDirectory={{ webapp_dir }}
Environment="CONFIG_PATH={{ webapp_dir }}/etc/mywebapp/config.json"
Environment="HTML_TEMPLATE_PATH={{ webapp_dir }}/templates/index.html"
ExecStart={{ webapp_dir }}/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:{{ webapp_port }} \
    app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
